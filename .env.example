# Local development defaults (copied to .env.local by scripts/dev-server.sh)
NODE_ENV=development
PORT=3001
VITEST=false

# Client WebSocket endpoint (Vite dev reads this; production uses Vercel env VITE_WEBSOCKET_URL)
VITE_WEBSOCKET_URL=ws://localhost:3001/ws

# Snapshots are offered by default; the server must confirm support.
# Build with 0 to disable the offer for a legacy-client rollback.
# VITE_SNAPSHOT_PROTOCOL=0

# Projectile/motion capability is offered by default after the server rollout.
# Use 0 for legacy-client verification or rollback (disable the Railway gate first).
# VITE_ASTEROID_INTERACTIONS=0
# Enable on Railway only after the enhanced Vercel client is live. Older
# gameplay WebSocket upgrades are rejected until the browser refreshes.
# REQUIRE_ASTEROID_CLIENT=1
