# Local development defaults (copied to .env.local by scripts/dev-server.sh)
NODE_ENV=development
PORT=3001
VITEST=false

# Optional endpoint for direct Vite runs; npm run dev uses its same-origin proxy.
# Production uses the Vercel VITE_WEBSOCKET_URL environment variable.
VITE_WEBSOCKET_URL=

# Gameplay requires snapshot v1 and asteroid interactions; no protocol switches.
