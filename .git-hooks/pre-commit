#!/usr/bin/env bash
# Commit-time quality gate; shared preamble supports explicit full manual runs.
# Vercel deploys the client after merge; this hook does not deploy.
set -euo pipefail

# shellcheck source=/dev/null
source "${DOTAGENTS_GATE_LIB:-$HOME/code/dotagents/gate/gate-lib.sh}" || {
  echo "✗ dotagents gate-lib not found (expected ~/code/dotagents/gate/gate-lib.sh) — re-run install-local-agent-runtime.sh." >&2
  exit 1
}
# Gate the tree being committed, not this copy's: under an absolute core.hooksPath (Claude
# desktop worktrees) this re-execs the committing tree's own hook; it sets ROOT and cd's.
gate_enter_committing_tree "${BASH_SOURCE[0]}"
gate_require_lib 12  # gate_check_bash_floor

gate_begin_commit "GeoRoids"    # staged secrets/lint and ordinary commit fast paths
run_step "bash floor" gate_check_bash_floor 'scripts/process-tree.sh' '.cursor/*'   # non-Cursor Bash entrypoints refuse Bash < 5
gate_require_node               # enforce the pinned Node (.nvmrc), not whatever's on PATH

# One complete repo-owned battery; the core never calls this hook.
run_step "complete gate" node scripts/gate.mjs
echo "✓ pre-commit gate passed; deployment follows merge."
