{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{ts,tsx,json,css,html,md}",
      "shared/**/*.{ts,tsx,json}",
      "shared-types.ts",
      "middleware.ts",
      "server/**/*.ts",
      "server.ts",
      "tests/**/*.{ts,tsx,json}",
      "scripts/*.ts",
      "benchmarks/**/*.{ts,html,json}",
      "setup/**/*.{ts,tsx,json}",
      "{package.json,tsconfig*.json,biome.jsonc,vitest*.config.ts,vite.config.ts,*.md}",
      "!tests/integration/browser/screenshots",
      "!**/node_modules/**/*"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noStaticOnlyClass": "error",
        "useOptionalChain": "error",
        // TypeScript requires bracket access for index signatures.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "useBiomeIgnoreFolder": "error",
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["debug", "info", "warn", "error"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "useNodejsImportProtocol": "error",
        "useTemplate": "error",
        "useConst": "error",
        "useBlockStatements": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**", "scripts/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": { "allow": ["log", "debug", "info", "warn", "error"] }
            }
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  }
}
