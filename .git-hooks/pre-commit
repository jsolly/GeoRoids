#!/usr/bin/env bash
# Commit-time quality gate; shared preamble supports explicit full manual runs.
# Vercel deploys the client after merge; this hook does not deploy.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"; cd "$ROOT"
# shellcheck source=/dev/null
source "${DOTAGENTS_GATE_LIB:-$HOME/code/dotagents/gate/gate-lib.sh}" || {
  echo "✗ dotagents gate-lib not found (expected ~/code/dotagents/gate/gate-lib.sh) — re-run install-local-agent-runtime.sh." >&2
  exit 1
}

gate_begin_commit "GeoRoids"    # staged secrets/lint and ordinary commit fast paths
gate_require_node               # enforce the pinned Node (.nvmrc), not whatever's on PATH

# --- Quality gate (run_step: silent on green, full output + abort on red) ---
run_step "dep grounding" gate_check_dep_grounding .git-hooks/pre-commit scripts/*.sh .railway/railway.ts
run_step "lint policy" npm run check:lint-policy
run_step "lint"   npm run lint
run_step "knip"   npm run check:knip
run_step "ts-prune" npm run check:ts-prune
run_step "markdown lint" npm run check:md
run_step "yaml lint" npm run check:yaml
run_step "actionlint" npm run check:actions
run_step "test runner contract" npm run check:test-runner
run_step "dev server contract" npm run check:dev-server
run_step "tsc"    npm run check:ts
run_step "vitest" npm test

run_step "build" npm run build
echo "✓ pre-commit gate passed; deployment follows merge."
