{
  "name": "georoids",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "sounds:generate": "tsx scripts/generate-sounds.ts",
    "worktree:init": "bash scripts/worktree-init.sh && npm ci",
    "prune": "npm run check:knip && npm run check:ts-prune",
    "logs": "tsx scripts/read-game-logs.ts",
    "benchmark": "NODE_ENV=production SERVER_LOG_LEVEL=error tsx benchmarks/run.ts",
    "dev": "./scripts/dev-server.sh",
    "dev:check": "./scripts/check-dev-servers.sh",
    "dev:kill": "./scripts/dev-server.sh --stop",
    "build": "npm run check:wiki && astro sync && tsc -p tsconfig.build.json && astro build && node scripts/check-built-client.mjs",
    "start": "astro dev --ignore-lock",
    "preview": "astro preview --ignore-lock",
    "test": "node scripts/validation-admission.mjs unit -- vitest run --project unit --project components",
    "test:review": "bash scripts/test-review.sh",
    "test:all": "npm run test && npm run test:integration",
    "test:integration": "./scripts/test-runner.sh --reporter=verbose",
    "test:integration:server": "./scripts/test-runner.sh tests/integration/server/",
    "test:integration:entities": "./scripts/test-runner.sh tests/integration/entities/",
    "check:test-runner": "node scripts/validation-admission.mjs contracts -- bash -c 'bash scripts/test-runner-contract.sh && node --test scripts/test-ports.test.mjs scripts/validation-admission.test.mjs scripts/check-built-client.test.mjs scripts/check-unused-typescript.test.mjs'",
    "check:dev-server": "bash scripts/dev-server-contract.sh",
    "check:ts": "astro sync && tsc --noEmit",
    "check:benchmarks": "tsc -p tsconfig.benchmarks.json",
    "check:md": "bash scripts/lint-md.sh",
    "check:yaml": "uvx yamllint@1.38.0 --strict .",
    "check:lint": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "fix": "npm run check:fix && npm run check:ts && npm run check:benchmarks && npm run test",
    "format": "biome format --write .",
    "check:actions": "node --import tsx --test scripts/server-release-inputs.test.mjs scripts/production-smoke-scenario.test.mjs && node scripts/ci-contract.mjs && node --test scripts/gate-contract.test.mjs && node scripts/review-receipt-contract.mjs && bash scripts/check-actions.sh",
    "gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
    "check:lint-policy": "bash scripts/lint-policy-contract.sh",
    "check:knip": "JITI_FS_CACHE=false knip --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "check:ts-prune": "node scripts/check-unused-typescript.mjs",
    "check:wiki": "tsx scripts/wiki-check.ts",
    "wiki:review": "tsx scripts/wiki-check.ts --accept",
    "wiki:media": "tsx scripts/wiki-media.ts",
    "wiki:media:check": "tsx scripts/wiki-media.ts --verify",
    "test:coverage": "node scripts/validation-admission.mjs unit -- vitest run --project unit --project components --coverage",
    "benchmark:realtime": "./scripts/test-runner.sh --benchmark-client",
    "benchmark:load": "./scripts/test-runner.sh --benchmark-load",
    "smoke:production": "node --import tsx scripts/production-smoke-entry.mjs",
    "smoke:scenario-contract": "node --import tsx --test scripts/server-release-inputs.test.mjs scripts/production-smoke-scenario.test.mjs",
    "check:frontend": "astro check --tsconfig ./tsconfig.frontend.json --minimumFailingSeverity warning && svelte-check --tsconfig ./tsconfig.frontend.json --fail-on-warnings",
    "check:format": "prettier --check \"src/**/*.{astro,svelte}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsolly/GeoRoids.git"
  },
  "author": "jsolly",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jsolly/GeoRoids/issues"
  },
  "homepage": "https://github.com/jsolly/GeoRoids#readme",
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.1",
    "@types/ws": "^8.18.1",
    "astro": "7.3.8",
    "echarts": "^6.1.0",
    "howler": "^2.2.4",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "uuid": "^14.0.2",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.5.1",
    "@biomejs/biome": "2.5.14",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/howler": "^2.2.13",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "bits-ui": "^2.19.5",
    "canvas": "^3.2.3",
    "cn": "0.4.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "jsonc-parser": "3.3.1",
    "knip": "6.38.0",
    "markdown-it": "^15.0.2",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "railway": "3.11.0",
    "shadcn-svelte": "1.7.0",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "ts-prune": "0.10.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "ts-prune": {
      "ts-morph": "28.0.0"
    },
    "shell-quote": ">=1.8.4",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.6.1",
    "markdownlint-cli2": {
      "markdown-it": "^14.2.0"
    }
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.27.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
