extends: relaxed

ignore: |
  node_modules/
  dist/
  .astro/
  .aws-sam/
  .vercel/
  .claude/
  .venv/
  .playwright-cli/
  .playwright-mcp/
  .tmp/
  .npm-cache/

rules:
  braces:
    level: error
  brackets:
    level: error
  colons:
    level: error
  commas:
    level: error
  empty-lines:
    level: error
  hyphens:
    level: error
  indentation:
    level: error
  # 80-char max is too tight for YAML carrying URLs, ARNs, and inline scripts.
  line-length: disable
