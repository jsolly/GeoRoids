{
  "name": "georoids",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "sounds:generate": "tsx scripts/generate-sounds.ts",
    "worktree:init": "bash scripts/worktree-init.sh && bash scripts/setup-agent-environment.sh",
    "prune": "npm run check:knip && npm run check:ts-prune && npm run check:members",
    "logs": "tsx scripts/read-game-logs.ts",
    "benchmark": "NODE_ENV=production SERVER_LOG_LEVEL=error tsx benchmarks/run.ts",
    "dev": "./scripts/dev-server.sh",
    "dev:check": "./scripts/check-dev-servers.sh",
    "dev:kill": "./scripts/dev-server.sh --stop",
    "build": "npm run check:wiki && astro sync --config config/app/astro.ts && node scripts/typescript-cli.mjs -p config/typescript/build.json && astro build --config config/app/astro.ts && node scripts/check-built-client.mjs && node scripts/build-vercel-output.mjs",
    "start": "astro dev --config config/app/astro.ts --ignore-lock",
    "preview": "astro preview --config config/app/astro.ts --ignore-lock",
    "test": "node scripts/validation-admission.mjs unit -- vitest run --config config/testing/vitest.ts --project unit --project components",
    "test:flight": "node scripts/verify-intentional-flight.mjs",
    "test:review": "bash scripts/test-review.sh",
    "test:all": "npm run test && npm run test:integration",
    "test:integration": "./scripts/test-runner.sh --reporter=verbose",
    "test:integration:server": "./scripts/test-runner.sh tests/integration/server/",
    "check:test-runner": "node scripts/validation-admission.mjs contracts -- bash scripts/test-runner-contract.sh",
    "check:dev-server": "vitest run --config config/testing/tooling.ts --project dev-server",
    "check:ts": "astro sync --config config/app/astro.ts && node scripts/typescript-cli.mjs --noEmit",
    "check:benchmarks": "node scripts/typescript-cli.mjs -p config/typescript/benchmarks.json",
    "check:md": "bash scripts/lint-md.sh",
    "check:yaml": "uvx yamllint@1.38.0 -c config/quality/yamllint.yaml --strict .",
    "check:lint": "biome check --config-path=config/quality/biome.settings.jsonc --error-on-warnings .",
    "check:fix": "biome check --config-path=config/quality/biome.settings.jsonc --write --error-on-warnings .",
    "fix": "npm run check:fix && npm run check:ts && npm run check:benchmarks && npm run test",
    "format": "biome format --config-path=config/quality/biome.settings.jsonc --write .",
    "check:repo-hooks": "uvx --from pytest==9.0.2 pytest -c config/testing/pytest.ini --rootdir=.",
    "check:actions": "vitest run --config config/testing/tooling.ts --project actions --project smoke && bash scripts/check-actions.sh",
    "gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
    "check:lint-policy": "vitest run --config config/testing/tooling.ts --project lint-policy",
    "check:knip": "JITI_FS_CACHE=false knip --config config/quality/knip.js --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "check:ts-prune": "node scripts/check-unused-typescript.mjs",
    "check:members": "node scripts/check-unused-class-members.mjs",
    "check:wiki": "tsx scripts/wiki-check.ts",
    "wiki:review": "tsx scripts/wiki-check.ts --accept",
    "wiki:merge": "node scripts/merge-wiki-ledger.mjs --merge",
    "wiki:media": "tsx scripts/wiki-media.ts",
    "wiki:media:check": "tsx scripts/wiki-media.ts --verify",
    "test:coverage": "node scripts/validation-admission.mjs unit -- vitest run --config config/testing/vitest.ts --project unit --project components --coverage",
    "benchmark:realtime": "./scripts/test-runner.sh --benchmark-client",
    "benchmark:load": "./scripts/test-runner.sh --benchmark-load",
    "smoke:production": "node --import tsx scripts/production-smoke-entry.mjs",
    "smoke:scenario-contract": "vitest run --config config/testing/tooling.ts --project smoke",
    "check:frontend": "astro check --config config/app/astro.ts --tsconfig ./tsconfig.frontend.json --minimumFailingSeverity warning && svelte-check --config ./config/app/svelte.js --tsconfig ./tsconfig.frontend.json --fail-on-warnings",
    "check:format": "prettier --config config/quality/prettier.json --check \"src/**/*.{astro,svelte}\"",
    "check:a11y": "node scripts/check-accessibility.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsolly/GeoRoids.git"
  },
  "author": "jsolly",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jsolly/GeoRoids/issues"
  },
  "homepage": "https://github.com/jsolly/GeoRoids#readme",
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.3.8",
    "echarts": "^6.1.0",
    "howler": "^2.2.4",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.5.1",
    "@biomejs/biome": "2.5.15",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/howler": "^2.2.13",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "5.0.4",
    "bits-ui": "^2.19.5",
    "canvas": "^3.2.3",
    "cn": "0.4.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "jsonc-parser": "3.3.1",
    "knip": "6.41.0",
    "markdown-it": "^15.0.3",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "railway": "3.16.0",
    "shadcn-svelte": "1.7.0",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "ts-prune": "0.10.3",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1",
    "axe-core": "^4.14.0"
  },
  "overrides": {
    "ts-prune": {
      "ts-morph": "28.0.0"
    },
    "shell-quote": ">=1.8.4",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.6.1",
    "markdownlint-cli2": {
      "markdown-it": "^14.2.0"
    }
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.27.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
