{
  "name": "georoids",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "worktree:init": "bash scripts/worktree-init.sh && npm ci",
    "prune": "ts-prune",
    "logs": "tsx scripts/read-game-logs.ts",
    "benchmark:game-loop": "NODE_ENV=production SERVER_LOG_LEVEL=info tsx scripts/benchmark-game-loop.ts",
    "dev": "./scripts/dev-server.sh",
    "dev:check": "./scripts/check-dev-servers.sh",
    "dev:kill": "./scripts/dev-server.sh --stop",
    "build": "npm run check:wiki && tsc -p tsconfig.build.json && vite build",
    "start": "vite",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run tests/unit/",
    "test:all": "npm run test && ./scripts/test-runner.sh tests/integration/server/ tests/integration/entities/",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "./scripts/test-runner.sh tests/integration/ --reporter=verbose",
    "test:integration:run": "./scripts/test-runner.sh tests/integration/ --reporter=verbose",
    "test:integration:browser": "./scripts/test-runner.sh tests/integration/browser/ --reporter=verbose",
    "test:integration:browser:e2e": "./scripts/test-runner.sh tests/integration/browser/e2e/ --reporter=verbose",
    "test:integration:browser:sanity": "./scripts/test-runner.sh tests/integration/browser/sanity/ --reporter=verbose",
    "test:integration:server": "./scripts/test-runner.sh tests/integration/server/",
    "test:integration:entities": "./scripts/test-runner.sh tests/integration/entities/",
    "check:test-runner": "bash scripts/test-runner-contract.sh",
    "check:dev-server": "bash scripts/dev-server-contract.sh",
    "check:ts": "tsc --noEmit",
    "check:md": "bash scripts/lint-md.sh",
    "check:yaml": "uvx yamllint@1.38.0 --strict .",
    "check:lint": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "fix": "biome check --write --error-on-warnings . && npm run check:ts && npm run test",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "prepare": "if [ -z \"$CI\" ] && git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .git-hooks; fi",
    "check:actions": "bash scripts/check-actions.sh",
    "gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
    "check:wiki": "tsx scripts/wiki-check.ts",
    "wiki:review": "tsx scripts/wiki-check.ts --accept",
    "wiki:media": "tsx scripts/wiki-media.ts",
    "wiki:media:check": "tsx scripts/wiki-media.ts --verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsolly/GeoRoids.git"
  },
  "author": "jsolly",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jsolly/GeoRoids/issues"
  },
  "homepage": "https://github.com/jsolly/GeoRoids#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@types/node": "^24.0.15",
    "@types/ws": "^8.18.1",
    "@vercel/functions": "^3.9.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/jsdom": "^21.1.1",
    "canvas": "^3.2.3",
    "concurrently": "^10.0.5",
    "github-actionlint": "^1.7.12",
    "jsdom": "^26.1.0",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.63.0",
    "ts-prune": "^0.10.3",
    "vercel": "^59.11.7",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "shell-quote": ">=1.8.4",
    "tar": ">=7.5.11",
    "minimatch": ">=10.2.3",
    "tmp": ">=0.2.6",
    "undici": ">=6.24.0",
    "ip-address": ">=10.1.1",
    "srvx": ">=0.11.13",
    "@tootallnate/once": ">=2.0.1",
    "path-to-regexp": ">=8.4.0",
    "adm-zip": "0.6.0",
    "ajv": "^8.18.0",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.6.1",
    "markdownlint-cli2": {
      "markdown-it": "^14.2.0"
    }
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.27.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
