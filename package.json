{
  "name": "georoids",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "worktree:init": "bash scripts/worktree-init.sh; npm ci",
    "prune": "ts-prune",
    "dev": "./scripts/dev-server.sh",
    "dev:check": "./scripts/check-dev-servers.sh",
    "dev:kill": "pkill -f 'tsx.*server.ts' || true && pkill -f 'vite' || true && pkill -f 'concurrently' || true && echo '✅ All dev server processes killed'",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "vite",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run tests/unit/",
    "test:all": "vitest run tests/unit/ tests/integration/server/ tests/integration/component/ tests/integration/entities/ --passWithNoTests",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "./scripts/test-runner.sh tests/integration/ --reporter=verbose",
    "test:integration:run": "./scripts/test-runner.sh tests/integration/ --reporter=verbose",
    "test:integration:browser": "./scripts/test-runner.sh tests/integration/browser/ --reporter=verbose",
    "test:integration:browser:e2e": "./scripts/test-runner.sh tests/integration/browser/e2e/ --reporter=verbose",
    "test:integration:browser:sanity": "./scripts/test-runner.sh tests/integration/browser/sanity/ --reporter=verbose",
    "test:integration:server": "vitest run tests/integration/server/",
    "test:integration:component": "vitest run tests/integration/component/ --passWithNoTests",
    "check:ts": "tsc --noEmit",
    "check:md": "bash scripts/lint-md.sh",
    "check:yaml": "uvx yamllint@1.38.0 .",
    "check:lint": "biome check .",
    "check:fix": "biome check --write .",
    "fix": "biome check --write . && npm run check:ts && npm run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "if [ -z \"$CI\" ] && git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .git-hooks; fi"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsolly/GeoRoids.git"
  },
  "author": "jsolly",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jsolly/GeoRoids/issues"
  },
  "homepage": "https://github.com/jsolly/GeoRoids#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@types/node": "^24.0.15",
    "@types/ws": "^8.18.1",
    "mongodb": "^7.3.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "uuid": "^11.0.0",
    "vite": "^8.1.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.40.0",
    "@types/chromedriver": "^81.0.5",
    "@types/jsdom": "^21.1.1",
    "@types/selenium-webdriver": "^4.1.28",
    "@vercel/node": "^5.3.6",
    "canvas": "^3.1.2",
    "chromedriver": "^152.0.1",
    "concurrently": "^10.0.3",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "markdownlint-cli2": "^0.22.1",
    "playwright": "^1.40.0",
    "selenium-webdriver": "^4.35.0",
    "ts-node": "^10.9.1",
    "ts-prune": "^0.10.3",
    "vercel": "^54.18.1",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "shell-quote": ">=1.8.4",
    "tar": ">=7.5.11",
    "minimatch": ">=10.2.3",
    "tmp": ">=0.2.6",
    "undici": ">=6.24.0",
    "ip-address": ">=10.1.1",
    "srvx": ">=0.11.13",
    "@tootallnate/once": ">=2.0.1",
    "path-to-regexp": ">=8.4.0"
  }
}
