# Local development defaults (copied to .env.local by scripts/dev-server.sh)
NODE_ENV=development
PORT=3001
VITEST=false

# Client WebSocket endpoint (Vite dev reads this; production uses Vercel env VITE_WEBSOCKET_URL)
VITE_WEBSOCKET_URL=ws://localhost:3001/ws

# Opt in only after snapshot-v1 server deployment is verified. Default: legacy.
# VITE_SNAPSHOT_PROTOCOL=1
